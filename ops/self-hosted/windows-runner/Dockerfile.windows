# JOY Media Windows self-hosted CI runner (container contract)
#
# This Dockerfile describes the Windows-container variant of the
# `self-hosted,windows,x64,joy-media-ci` runner label. It is intended to be
# built and run on the owner-controlled Windows PC via Docker Desktop with
# the Windows-container engine enabled (Settings → "Use Windows containers
# instead of Linux containers").
#
# The release gate accepts Windows evidence only from this exact
# `self-hosted,windows,x64,joy-media-ci` runner. This image is deliberately a
# Windows-container contract: host-direct Windows runners and Linux portable
# evidence are not acceptance substitutes.

# windows/servercore is the canonical base for non-GUI Windows
# containers. The tag is intentionally pinned to a digest in any real
# build; the manifest below documents what would be pinned.
ARG WINDOWS_BASE=mcr.microsoft.com/windows/servercore:ltsc2022
FROM ${WINDOWS_BASE}

SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

# Pinned tooling versions (kept in lockstep with ops/self-hosted/linux-runner/Dockerfile).
ARG NODE_VERSION=22.14.0
ARG NODE_SHA256=69b09dba5c8dcb05c4e4273a4340db1005abeafe3927efda2bc5b249e80437ec
ARG RUNNER_VERSION=2.337.0
ARG RUNNER_SHA256=70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613

# The Server Core base is expected to contain Chocolatey in the owner-managed
# build environment. The build explicitly validates that assumption before
# invoking it; a missing package manager is a hard build failure.

ENV COREPACK_HOME="C:\\corepack" `
    NODE_VERSION="${NODE_VERSION}" `
    NODE_SHA256="${NODE_SHA256}" `
    RUNNER_VERSION="${RUNNER_VERSION}" `
    RUNNER_SHA256="${RUNNER_SHA256}" `
    PATH="C:\\actions-runner\\bin;C:\\node;${PATH}"

RUN [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 ; `
    $choco = Get-Command choco.exe -ErrorAction SilentlyContinue ; `
    if (-not $choco) { throw 'Chocolatey is required in the Windows build image; bootstrap it in the pinned base image before building.' } ; `
    Write-Host 'Installing chocolatey packages (git, ffmpeg, curl, jq)' ; `
    choco install -y --no-progress git ffmpeg curl jq ; `
    Remove-Item -Recurse -Force C:\ProgramData\chocolatey\lib\*.install.log -ErrorAction SilentlyContinue ; `
    Write-Host 'Installing Node.js' ; `
    $nodeArchive = Join-Path $env:TEMP ("node-v$($env:NODE_VERSION)-win-x64.zip") ; `
    Invoke-WebRequest -UseBasicParsing -Uri "https://nodejs.org/dist/v$($env:NODE_VERSION)/node-v$($env:NODE_VERSION)-win-x64.zip" -OutFile $nodeArchive ; `
    $expected = $env:NODE_SHA256 ; `
    $actual = (Get-FileHash -LiteralPath $nodeArchive -Algorithm SHA256).Hash.ToLowerInvariant() ; `
    if ($actual -ne $expected) { throw "Node.js hash mismatch: expected $expected, got $actual" } ; `
    $nodeExtract = Join-Path $env:TEMP 'joy-node-extract' ; `
    Remove-Item -LiteralPath $nodeExtract -Recurse -Force -ErrorAction SilentlyContinue ; `
    Expand-Archive -LiteralPath $nodeArchive -DestinationPath $nodeExtract -Force ; `
    $nodeRoot = Get-ChildItem -LiteralPath $nodeExtract -Directory | Select-Object -First 1 ; `
    if (-not $nodeRoot -or -not (Test-Path -LiteralPath (Join-Path $nodeRoot.FullName 'node.exe'))) { throw 'Node archive did not contain the expected node.exe layout.' } ; `
    Remove-Item -LiteralPath C:\node -Recurse -Force -ErrorAction SilentlyContinue ; `
    Move-Item -LiteralPath $nodeRoot.FullName -Destination C:\node ; `
    Remove-Item -LiteralPath $nodeExtract -Recurse -Force ; `
    Remove-Item -LiteralPath $nodeArchive -Force ; `
    & C:\node\corepack.cmd enable ; `
    $env:COREPACK_HOME = 'C:\corepack' ; `
    & C:\node\corepack.cmd install --global pnpm@11.15.0 ; `
    Write-Host 'Installing GitHub Actions runner' ; `
    $runnerArchive = Join-Path $env:TEMP ("actions-runner-win-x64-$($env:RUNNER_VERSION).zip") ; `
    Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/actions/runner/releases/download/v$($env:RUNNER_VERSION)/actions-runner-win-x64-$($env:RUNNER_VERSION).zip" -OutFile $runnerArchive ; `
    $expectedRunner = $env:RUNNER_SHA256 ; `
    $actualRunner = (Get-FileHash -LiteralPath $runnerArchive -Algorithm SHA256).Hash.ToLowerInvariant() ; `
    if ($actualRunner -ne $expectedRunner) { throw "Runner hash mismatch: expected $expectedRunner, got $actualRunner" } ; `
    Expand-Archive -LiteralPath $runnerArchive -DestinationPath C:\actions-runner -Force ; `
    Remove-Item -LiteralPath $runnerArchive -Force ; `
    New-Item -ItemType Directory -Path C:\actions-runner\_work -Force | Out-Null

COPY windows-runner-entrypoint.ps1 C:/actions-runner/joy-media-windows-runner.ps1

WORKDIR C:/actions-runner
ENTRYPOINT ["powershell", "-NoProfile", "-File", "C:\\actions-runner\\joy-media-windows-runner.ps1"]
