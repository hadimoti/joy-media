{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.joy.media/cli/v1/doctor-report.schema.json",
  "title": "JOY Media CLI doctor report v1",
  "type": "object",
  "required": ["ok", "summary", "checks"],
  "properties": {
    "ok": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail", "skip"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "warn", "fail", "skip"] },
          "message": { "type": "string" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
