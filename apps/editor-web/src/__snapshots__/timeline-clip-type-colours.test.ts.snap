// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Clip colour by type (T-D11) > 'audio' clip rule snapshot 1`] = `
{
  "sharedFill": "--clip-tint: color-mix(in srgb, var(--clip-type) 28%, var(--joy-bg-raised));
  --clip-rail-fill: var(--clip-type);
  background:
    linear-gradient(180deg, rgb(255 255 255 / 12%), transparent 42%, rgb(0 0 0 / 18%)),
    var(--clip-tint);",
  "typeRule": "--clip-type: #3cc8b4;",
}
`;

