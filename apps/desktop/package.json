{
  "name": "@joy-media/desktop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/electron-entry.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && node scripts/copy-static.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "electron . --smoke",
    "test:smoke-packaged": "node scripts/smoke-packaged.mjs",
    "dev:electron": "electron .",
    "package:dev": "node scripts/package-dev.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:staging": "node scripts/package-release.mjs --staging",
    "package:unpacked": "node scripts/package-release.mjs --unpacked",
    "package:installer": "node scripts/package-installer.mjs",
    "test:smoke-standalone": "node scripts/smoke-standalone.mjs"
  },
  "dependencies": {
    "@joy-media/provider-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "electron": "^44.3.0"
  }
}
