{
  "name": "joy-media",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:audit": "playwright test tests/e2e --project=desktop-primary --project=desktop-compact --project=desktop-minimum --project=desktop-1280 --project=desktop-1440 --project=desktop-1581 --project=desktop-1920",
    "test:fixtures:media": "node tooling/generate-media-fixtures.mjs",
    "worker:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-worker-exe.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod --audit-level=moderate",
    "release:gate": "node --experimental-strip-types tooling/release/src/gate.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify:ci": "pnpm check && pnpm build && pnpm audit:prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.0"
  }
}
