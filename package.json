{
  "name": "joy-media",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run packages tooling",
    "test:editor": "vitest run apps/editor-web/src",
    "test:api": "vitest run apps/api/src",
    "test:worker": "vitest run apps/worker/src",
    "test:release": "pnpm test:unit && pnpm test:editor && pnpm test:api && pnpm test:worker",
    "release:gate": "pnpm --filter @joy-media/release gate",
    "release:gate:test": "pnpm --filter @joy-media/release test",
    "desktop:build": "pnpm --filter @joy-media/desktop build",
    "desktop:package": "pnpm --filter @joy-media/desktop package:win",
    "desktop:package:signed": "node apps/desktop/scripts/package-windows.mjs && node apps/desktop/scripts/sign-windows-installer.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.31.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.1"
  }
}
