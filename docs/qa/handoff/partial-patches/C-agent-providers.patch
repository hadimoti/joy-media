+import { describeRun, type RunResult } from './harness.js';
+
+const posix = process.platform !== 'win32';
+const KEY = fakeKey('secret');
+
+describe('API keys at rest', () => {
+  let mock: MockLlmServer;
+  let env: AgentSandbox;
+
+  beforeAll(async () => {
+    mock = await startMockLlm();
+  });
+  afterAll(async () => {
