+  afterEach(() => {
+    expect(env.externalCalls()).toEqual([]);
+    env.cleanup();
+  });
+
+  it.runIf(posix)('ai-providers.json is 0600 and ~/.joy-media is 0700 on a fresh install', async () => {
+    const r = await env.run(['agent', 'provider', 'add', 'p', '--url', mock.url, '--api-key', KEY]);
+    expect(r.code, describeRun(r)).toBe(0);
