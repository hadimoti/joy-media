+    it('keeps stdout for JSON only: no banner, every human log goes to stderr', () => {
+      setMachineOutput(true);
+      printBanner();
+      logInfo('info');
+      logSuccess('done');
+      logWarn('careful');
+      logStep('Label', 'detail');
+      logLine('plain');
+      printTable(['A'], [['1']]);
+      logError('broken');
+      printJson({ ok: true });
