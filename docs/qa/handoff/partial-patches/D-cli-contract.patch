+      expect(err.join('\n')).toMatch(/ℹ info[\s\S]*✔ done[\s\S]*▲ careful[\s\S]*Label: detail/);
+      expect(err).toContain('✖ broken');
+      expect(err.join('\n')).not.toMatch(/JOY MEDIA CLI/);
+    });
